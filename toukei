import sys
import math


def main():
    numbers = []
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            numbers.append(float(line))
        except ValueError:
            print(f"Error: invalid number '{line}'", file=sys.stderr)
            sys.exit(1)

    if not numbers:
        print("Error: no input data", file=sys.stderr)
        sys.exit(1)

    n = len(numbers)
    total = sum(numbers)
    mean = total / n
    sorted_nums = sorted(numbers)
    if n % 2 == 1:
        median = sorted_nums[n // 2]
    else:
        median = (sorted_nums[n // 2 - 1] + sorted_nums[n // 2]) / 2.0

    min_val = sorted_nums[0]
    max_val = sorted_nums[-1]
    variance = sum((x - mean) ** 2 for x in numbers) / n
    std_dev = math.sqrt(variance)

    print(f"count: {n}")
    print(f"sum: {total:g}")
    print(f"mean: {mean:g}")
    print(f"median: {median:g}")
    print(f"min: {min_val:g}")
    print(f"max: {max_val:g}")
    print(f"std: {std_dev:g}")


if __name__ == "__main__":
    main()
