import sys


def main():
    numbers = []
    for line in sys.stdin:
        line = line.strip()
        if line:
            numbers.append(float(line))

    n = len(numbers)
    total = sum(numbers)
    mean = total / n

    print(f"count: {n}")
    print(f"sum: {total:g}")
    print(f"mean: {mean:g}")
    print(f"min: {min(numbers):g}")
    print(f"max: {max(numbers):g}")


if __name__ == "__main__":
    main()
